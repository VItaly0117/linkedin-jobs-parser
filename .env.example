# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgres://linkedin:linkedin@db:5432/linkedin

# Учётная запись админки (создаётся при первом старте web)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Парсер
# Запросов в секунду (общий лимит на процесс)
LINKEDIN_RPS=1.0
# Попыток на один HTTP-запрос
LINKEDIN_MAX_RETRIES=6
LINKEDIN_TIMEOUT=30
# Попыток на одну вакансию/компанию до статуса «Ошибка»
LINKEDIN_MAX_ATTEMPTS=5
# Прокси через запятую: http://user:pass@host:port,...
LINKEDIN_PROXIES=
